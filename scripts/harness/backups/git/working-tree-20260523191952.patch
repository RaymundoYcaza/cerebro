diff --git a/Makefile b/Makefile
index 8f7d577..8301bd7 100644
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,30 @@
-.PHONY: run
+.PHONY: run check test reflective technical help
+
+PYTHON ?= python3
 
 run:
 	.venv/bin/python scripts/capture/main.py
+
+help:
+	@echo "Available targets:"
+	@echo "  run          – Existing run target"
+	@echo "  check        – Run harness checks"
+	@echo "  test         – Run all smoke tests"
+	@echo "  reflective   – Execute reflective note processing"
+	@echo "  technical    – Execute technical note processing"
+
+# Harness checks
+check:
+	$(PYTHON) scripts/harness/harness.py check
+
+# Run all smoke tests (cerebro_notes)
+test:
+	$(PYTHON) -m pytest scripts/cerebro_notes/tests/smoke
+
+# Reflective note flow (default config)
+reflective:
+	$(PYTHON) scripts/cerebro_notes/run_reflective_from_note.py --config scripts/harness/config.yaml
+
+# Technical note flow (default config)
+technical:
+	$(PYTHON) scripts/cerebro_notes/run_technical.py --config scripts/harness/config.yaml
